{
  "name": "flint-webhook-receiver-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "setup": "node --env-file-if-exists=.env scripts/setup.ts",
    "webhooks": "node --env-file-if-exists=.env scripts/webhooks.ts",
    "check": "tsc --noEmit && node --test tests/unit/*.test.ts",
    "test": "node --test tests/unit/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env --test tests/integration/*.test.ts"
  },
  "dependencies": {
    "@flintpay/node": "7.0.0",
    "@hono/node-server": "^1.19.0",
    "hono": "^4.10.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
