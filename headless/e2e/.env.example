# Template only. Inject values into the parent process from private configuration.
# The harness never loads .env files. No real identifiers belong in this file.
E2E_FLINT_API_BASE_URL=https://api.staging.withflintpay.com
E2E_SANDBOX_A_ID=test_PLACEHOLDER_A
E2E_SANDBOX_A_API_KEY=flint_test_PLACEHOLDER_A
E2E_SANDBOX_B_ID=test_PLACEHOLDER_B
E2E_SANDBOX_B_API_KEY=flint_test_PLACEHOLDER_B
E2E_INBOX=
E2E_INBOX_ADDRESS=buyer@example.invalid
E2E_IMAP_HOST=
E2E_IMAP_PORT=993
E2E_IMAP_USER=
E2E_IMAP_PASSWORD=
E2E_SUITE=standard
E2E_SANDBOX_A_MERCHANT_ID=mer_PLACEHOLDER
E2E_SANDBOX_A_PROVIDER_ID=acct_PLACEHOLDER_A
E2E_SANDBOX_B_MERCHANT_ID=mer_PLACEHOLDER
E2E_SANDBOX_B_PROVIDER_ID=acct_PLACEHOLDER_B
E2E_TARGET_COMMIT=<examples-candidate-40-hex-sha>
E2E_API_TARGET_COMMIT=<flint-candidate-40-hex-sha>
E2E_STOREFRONT_A_ARTIFACT_ID=<immutable-artifact-id>
E2E_STOREFRONT_B_ARTIFACT_ID=<immutable-artifact-id>
E2E_ACCOUNT_A_ARTIFACT_ID=<immutable-artifact-id>
E2E_API_ARTIFACT_ID=<immutable-artifact-id>
E2E_STOREFRONT_A_ORIGIN=http://localhost:4100
E2E_STOREFRONT_B_ORIGIN=http://localhost:4110
E2E_ACCOUNT_A_ORIGIN=http://localhost:4200
E2E_PRIVATE_RUN_DIR=<absolute-private-directory-outside-checkout>
E2E_FIXTURE_FILE=<absolute-private-fixture-manifest>
E2E_RUN_ID=<yyyymmddThhmmssZ-8hex>
E2E_WEBHOOK_SECRET=
# Operator A has fixture authority; app keys above must exclude gift secrets scope.
# Never pass either operator variable to the app processes.
E2E_OPERATOR_A_API_KEY=flint_test_OPERATOR_PLACEHOLDER_A
# Optional separate operator for B; otherwise the narrow B key performs B operations.
E2E_OPERATOR_B_API_KEY=
E2E_STOREFRONT_A_HEALTH_PATH=/healthz
E2E_STOREFRONT_B_HEALTH_PATH=/healthz
E2E_ACCOUNT_A_HEALTH_PATH=/healthz
E2E_API_HEALTH_PATH=/health
