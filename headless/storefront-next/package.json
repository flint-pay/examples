{
  "name": "flint-headless-storefront-next-example",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --port ${PORT:-4300}",
    "build": "next build",
    "start": "next start --port ${PORT:-4300}",
    "setup": "node --env-file-if-exists=.env scripts/setup.ts",
    "check": "tsc --noEmit && node --test tests/unit/*.test.ts",
    "test": "node --test tests/unit/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@flintpay/node": "3.0.0-beta.20261012044000",
    "@stripe/stripe-js": "10.0.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3"
  }
}
